		<!--<ObjectAttribute title="Product" class="sapUiTinyMargin sapUiSmallMarginBegin"/>-->
		<TextArea id="TextAreaId" width="90%" class="sapUiTinyMargin sapUiSmallMarginBegin"/>
		<Toolbar class="foot">
			<ToolbarSpacer/>
			<Button text="Edit" press="OnEditTextArea"></Button>
