<mvc:View controllerName="companyportal.controller.Page1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt" >
    <Page id="page" title="{i18n>title}">
        	<tnt:ToolHeader id="shellLikeToolHeader" class="sapUiTinyMargin">
			
			<Image src="test-resources/sap/tnt/images/SAP_Logo.png" decorative="false" press="onLogoPressed" tooltip="SAP Logo" width="60px" height="30px">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow"/>
				</layoutData>
			</Image>
			<Title text="E-Commerce" wrapping="false" id="productName">
				<layoutData>
					<OverflowToolbarLayoutData priority="Disappear"/>
				</layoutData>
			</Title>
			
			<ToolbarSpacer />
			
			<Avatar src="test-resources/sap/tnt/images/Woman_avatar_01.png" displaySize="XS" press=".onAvatarPressed" tooltip="Profile">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow"/>
				</layoutData>
			</Avatar>
		</tnt:ToolHeader>

        <Table
		items="{
			path: 'ProductModel>/data',
			sorter: {
				path: 'Name'
			}
		}">
		<headerToolbar>
			<OverflowToolbar>
				<Title text="Products" level="H2"/>
				<ToolbarSpacer/>
				
				<Button text="Add"  press="onAddPress"/>
			</OverflowToolbar>
		</headerToolbar>
		<columns>
			<Column>
				<Text text="Product Name" />
			</Column>
			<Column>
				<Text text="Company" />
			</Column>
			<Column>
				<Text text="Category" />
			</Column>
			<Column>
				<Text text="Model" />
			</Column>
            <Column>
				<Text text="Price" />
			</Column>
            <Column>
				<Text text="Rating" />
			</Column>
            <Column hAlign="Center">
				<Text text="Action" />
			</Column>

		</columns>
		<items>
			<ColumnListItem vAlign="Middle" type="Navigation">
				<cells>
					<Text text="{ProductModel>productName}" />
					<Text text="{ProductModel>brand}"/>
					<Text text="{ProductModel>category}"/>
					<Text text="{ProductModel>model}" />
                    <Text text="{ProductModel>price}" />
                    <Text text="{ProductModel>rating}" />
                    <HBox justifyContent="SpaceAround">
                        <Button icon="sap-icon://edit" />
						<Button icon="sap-icon://delete" />
                    </HBox>
				</cells>
			</ColumnListItem>
		</items>
	</Table>
    </Page>
</mvc:View>